{
  "format_version": 1,
  "scenarios": [
    {
      "id": "shell-regressions",
      "level": "isolated-process",
      "initial": "fresh temporary directory, allowlisted environment, immutable legacy fixtures",
      "entrypoint": "python3 tests/run.py",
      "preserve": [
        "non-managed lines",
        "file permissions",
        "outside test directory"
      ],
      "mutations": [
        "test directory only"
      ]
    },
    {
      "id": "ssh-node-adapters",
      "level": "mocked-service-adapter",
      "initial": "fresh sshd configuration and generated fixture key",
      "entrypoint": "python3 -m unittest discover -s ssh/tests",
      "preserve": [
        "original config on failure",
        "existing CA on failure"
      ],
      "mutations": [
        "test directory only"
      ]
    },
    {
      "id": "hud-lifecycle",
      "level": "native-process-local-http",
      "initial": "allowlisted environment, empty isolated configuration",
      "entrypoint": "python3 codex-hud/tests/lifecycle.py <candidate>",
      "preserve": [
        "other hooks",
        "user rules",
        "key on upgrade"
      ],
      "mutations": [
        "test directory only"
      ]
    },
    {
      "id": "linux-system",
      "level": "full-system-qemu",
      "initial": "verified base image and fresh overlay",
      "entrypoint": "python3 tests/system/vm.py --image ubuntu --suite core",
      "preserve": [
        "existing credentials",
        "non-managed configuration",
        "host runner"
      ],
      "mutations": [
        "guest managed files and declared package state"
      ]
    },
    {
      "id": "native-package",
      "level": "native-process",
      "initial": "immutable candidate archives and isolated temporary HOME on each declared architecture",
      "entrypoint": "python3 tests/package.py --assets <candidate>",
      "preserve": [
        "existing command",
        "personal HOME",
        "read-only render state"
      ],
      "mutations": [
        "isolated staging directory"
      ]
    },
    {
      "id": "ssh-launchd",
      "level": "native-platform",
      "initial": "new standard account with account-database HOME and independent user launchd domain on macOS 15 runner",
      "entrypoint": "python3 tests/macos_launchd.py --assets <candidate>",
      "preserve": [
        "unrelated accounts and homes",
        "fixture client key",
        "valid certificate",
        "disabled and unloaded choices"
      ],
      "mutations": [
        "dedicated fixture account and its user domain",
        "owned task files and SSH fixtures"
      ]
    },
    {
      "id": "ssh-launchd-gui",
      "level": "native-platform",
      "initial": "disposable macOS 15 runner GUI account; all fixture paths and task registration confirmed absent",
      "entrypoint": "python3 tests/macos_launchd.py --assets <candidate> --session gui",
      "preserve": [
        "existing runner resources",
        "legacy task domain, interval, environment and logs",
        "fixture key",
        "hand-edited task"
      ],
      "mutations": [
        "explicit absent fixture paths in actual runner HOME",
        "fixture launchd registration only"
      ]
    }
  ]
}
