{
  "format_version": 1,
  "components": {
    "file-transactions": {
      "paths": [
        "lib/**",
        "scripts/embed.py"
      ],
      "depends_on": [],
      "jobs": [
        "behavior"
      ],
      "scenarios": [
        "shell-regressions"
      ]
    },
    "ssh-contract": {
      "paths": [
        "ssh/**"
      ],
      "depends_on": [],
      "jobs": [
        "behavior",
        "system",
        "go"
      ],
      "scenarios": [
        "shell-regressions",
        "ssh-node-adapters",
        "linux-system",
        "native-package",
        "ssh-launchd",
        "ssh-launchd-gui"
      ]
    },
    "shell-proxy": {
      "paths": [
        "common/setup_proxy_config.sh"
      ],
      "depends_on": [
        "file-transactions"
      ],
      "jobs": [
        "behavior"
      ],
      "scenarios": [
        "shell-regressions"
      ]
    },
    "shell-zsh": {
      "paths": [
        "common/setup_zsh_p10k.sh"
      ],
      "depends_on": [
        "file-transactions"
      ],
      "jobs": [
        "behavior"
      ],
      "scenarios": [
        "shell-regressions"
      ]
    },
    "shell-node": {
      "paths": [
        "common/setup_node_env.sh"
      ],
      "depends_on": [],
      "jobs": [
        "behavior",
        "system"
      ],
      "scenarios": [
        "shell-regressions",
        "linux-system"
      ]
    },
    "shell-access": {
