        "behavior",
        "go"
      ],
      "scenarios": [
        "hud-lifecycle"
      ]
    },
    "packaging": {
      "paths": [
        "scripts/build_release.py",
        "scripts/install-ssh.sh",
        "scripts/release_check.py"
      ],
      "depends_on": [],
      "jobs": [
        "behavior",
        "system",
        "go"
      ],
      "scenarios": [
        "shell-regressions",
        "linux-system",
        "native-package",
        "ssh-launchd",
        "ssh-launchd-gui"
      ]
    }
