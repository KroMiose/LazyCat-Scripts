        "ssh-contract"
      ],
      "jobs": [
        "behavior"
      ],
      "scenarios": [
        "shell-regressions"
      ]
    },
    "shell-recovery": {
      "paths": [
        "common/lazycat-check.sh",
        "common/restore_shell_backup.sh"
